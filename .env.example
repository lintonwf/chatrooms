# Copy this file to .env and fill in your values.
# Never commit .env to version control.

DATABASE_URL=postgresql://chatadmin:ChatRooms_2024@localhost:5432/chatrooms
SECRET_KEY=replace-with-a-long-random-string
FLASK_APP=app.py
FLASK_ENV=development

# Microsoft Entra ID credentials (from Part 1)
CLIENT_ID=your-application-client-id-here
CLIENT_SECRET=your-client-secret-value-here
TENANT_ID=your-directory-tenant-id-here

# Flask session security key (generate a long random string)
SECRET_KEY=replace-with-a-long-random-string
